#!/bin/bash

# Load configuration from .env
ENV_FILE="$(dirname "$(realpath "$0")")/.env"
if [ ! -f "$ENV_FILE" ]; then
    echo "Error: .env file not found at $ENV_FILE"
    echo "Copy .env.example to .env and fill in your mount configurations."
    exit 1
fi
source "$ENV_FILE"

# Build MOUNTS array from MOUNT_* variables defined in .env
declare -A MOUNTS
for var in $(compgen -v MOUNT_); do
    MOUNTS["${var#MOUNT_}"]="${!var}"
done

# Build TUNNELS array from TUNNEL_* variables defined in .env (format: hostname|port)
declare -A TUNNELS
for var in $(compgen -v TUNNEL_); do
    TUNNELS["${var#TUNNEL_}"]="${!var}"
done

usage() {
    echo "Usage: $0 <tunnel_name>"
    echo "       $0 --all"
    echo ""
    echo "Available tunnels:"
    for name in "${!TUNNELS[@]}"; do
        IFS='|' read -r cf_tunnel port <<< "${TUNNELS[$name]}"
        echo "  $name -> $cf_tunnel on localhost:$port"
    done
    for name in "${!MOUNTS[@]}"; do
        IFS='|' read -r ip share mount_point domain user port cf_tunnel <<< "${MOUNTS[$name]}"
        if [ -n "$cf_tunnel" ]; then
            echo "  $name -> $cf_tunnel on localhost:$port  (mount)"
        fi
    done
    exit 1
}

stop_tunnel() {
    local name=$1
    local pid_file="/tmp/cf-tunnel-${name}.pid"

    if [ ! -f "$pid_file" ]; then
        echo "Tunnel '$name' is not running (no PID file found)"
        return 0
    fi

    local pid
    pid=$(cat "$pid_file")

    if ! kill -0 "$pid" 2>/dev/null; then
        echo "Tunnel '$name' is not running (process $pid is gone)"
        rm -f "$pid_file"
        return 0
    fi

    echo "Stopping Cloudflare tunnel '$name' (PID $pid)..."
    kill "$pid"

    local elapsed=0
    while [ $elapsed -lt 5 ]; do
        if ! kill -0 "$pid" 2>/dev/null; then
            break
        fi
        sleep 1
        elapsed=$((elapsed + 1))
    done

    if kill -0 "$pid" 2>/dev/null; then
        echo "Process did not exit, sending SIGKILL..."
        kill -9 "$pid" 2>/dev/null
    fi

    rm -f "$pid_file"
    echo "Tunnel '$name' stopped"
}

if [ $# -eq 0 ]; then
    usage
fi

if [ "$1" = "--all" ] || [ "$1" = "-all" ]; then
    shopt -s nullglob
    pid_files=(/tmp/cf-tunnel-*.pid)
    if [ ${#pid_files[@]} -eq 0 ]; then
        echo "No running tunnels found"
        exit 0
    fi
    for pid_file in "${pid_files[@]}"; do
        name="${pid_file#/tmp/cf-tunnel-}"
        name="${name%.pid}"
        stop_tunnel "$name"
    done
    exit 0
fi

MOUNT_NAME=$1

# Resolve tunnel config: check TUNNELS first, then MOUNTS
if [ -n "${TUNNELS[$MOUNT_NAME]}" ]; then
    IFS='|' read -r CF_TUNNEL PORT <<< "${TUNNELS[$MOUNT_NAME]}"
elif [ -n "${MOUNTS[$MOUNT_NAME]}" ]; then
    IFS='|' read -r SERVER_IP SHARE MOUNT_POINT DOMAIN USERNAME PORT CF_TUNNEL <<< "${MOUNTS[$MOUNT_NAME]}"
else
    echo "Error: Tunnel configuration '$MOUNT_NAME' not found"
    usage
fi

if [ -z "$CF_TUNNEL" ] || [ -z "$PORT" ]; then
    echo "Error: '$MOUNT_NAME' is not a Cloudflare Tunnel entry"
    exit 1
fi

stop_tunnel "$MOUNT_NAME"
